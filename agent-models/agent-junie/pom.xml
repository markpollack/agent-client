<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.markpollack</groupId>
        <artifactId>agent-client-parent</artifactId>
        <version>0.30.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>agent-junie</artifactId>
    <packaging>jar</packaging>

    <name>Agent Junie</name>
    <description>AgentApi adapter for the JetBrains Junie CLI, driven over the Agent Client Protocol</description>

    <dependencies>
        <!-- Core Agent Model -->
        <dependency>
            <groupId>io.github.markpollack</groupId>
            <artifactId>agent-model</artifactId>
        </dependency>

        <!--
          Junie has no bespoke CLI SDK in this repository, and deliberately so: it speaks
          the Agent Client Protocol, so the published ACP client is the transport. This
          mirrors agent-claude, which depends on the external claude-code-sdk rather than
          carrying a provider-sdks module.
        -->
        <!--
          The shared ACP adapter. Junie's protocol handling was extracted here once a
          second ACP agent showed which parts were protocol and which were Junie; acp-core
          arrives transitively with it and stays declared for the autoconfiguration.
        -->
        <dependency>
            <groupId>io.github.markpollack</groupId>
            <artifactId>agent-acp</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.agentclientprotocol</groupId>
            <artifactId>acp-core</artifactId>
            <version>${acp.version}</version>
        </dependency>

        <!-- Agent Journal trajectory capture -->
        <dependency>
            <groupId>io.github.markpollack</groupId>
            <artifactId>junie-cli-capture</artifactId>
            <version>${agent-journal.version}</version>
        </dependency>

        <!-- Spring Boot AutoConfiguration -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- Jackson 2 (explicit; was transitive via Spring AI, which moved to Jackson 3 at 2.0 GA) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.github.markpollack</groupId>
            <artifactId>agent-tck</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- The AgentClient facade is what exposes getPhaseCapture() to a consumer -->
        <dependency>
            <groupId>io.github.markpollack</groupId>
            <artifactId>agent-client-core</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
