<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.markpollack</groupId>
        <artifactId>agent-starters</artifactId>
        <version>0.27.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>agent-starter-gemini</artifactId>
    <packaging>jar</packaging>

    <name>Agent Starter - Gemini</name>
    <description>Spring Boot Starter for Spring AI Gemini Agent</description>

    <dependencies>
        <!-- Spring Boot Starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Agent Client (includes AgentClient autoconfiguration) -->
        <dependency>
            <groupId>io.github.markpollack</groupId>
            <artifactId>agent-client-spring-boot-autoconfigure</artifactId>
            <version>${project.parent.version}</version>
        </dependency>

        <!-- Gemini Agent Model (includes Gemini autoconfiguration) -->
        <dependency>
            <groupId>io.github.markpollack</groupId>
            <artifactId>agent-gemini</artifactId>
            <version>${project.parent.version}</version>
        </dependency>

        <!-- Keep the Boot logging family on the repository's published security floor. -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j2.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-to-slf4j</artifactId>
            <version>${log4j2.version}</version>
        </dependency>

    </dependencies>

</project>
